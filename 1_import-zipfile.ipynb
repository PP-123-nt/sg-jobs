   "source": [
    "## 1. create a new jupyter notebook\n",
    "## 2. copy csv.zip file into the same folder\n",
    "## 3. run the following code to extract csv.zip to csv\n",
    "\n",
    "import zipfile\n",
    "\n",
    "zip_path = 'SGJobData.csv.zip' \n",
    "\n",
    "with zipfile.ZipFile(zip_path) as z:\n",
    "    z.extract('SGJobData.csv', '.')"
   ]
  }
